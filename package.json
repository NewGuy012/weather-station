{
  "name": "us-weather-station",
  "version": "0.1.0",
  "description": "Interactive 50-state US weather station powered by Bun, TypeScript, Open-Meteo, NWS, and NOAA/IEM Doppler radar.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot src/server/dev.ts",
    "build": "tsc -b && bun run src/server/scripts/buildClient.ts",
    "preview": "bun run build && NODE_ENV=production bun src/server/dev.ts",
    "deploy": "wrangler deploy",
    "check": "bun run build && wrangler deploy --dry-run",
    "typecheck": "tsc -b",
    "test": "bun test",
    "seed": "bun run src/server/scripts/generateSeed.ts"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/topojson-client": "^3.1.5",
    "bun-plugin-tailwind": "^0.1.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.136.1"
  }
}
